{
  "manifest_version": 3,
  "name": "LG Smart TV Remote",
  "version": "1.0.0",
  "description": "Control your LG webOS Smart TV directly from Chrome: volume, D-Pad, apps, playback, and cast tab URLs.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "LG TV Remote",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:8765/*",
    "ws://localhost:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
